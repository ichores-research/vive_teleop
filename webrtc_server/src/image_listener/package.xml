<?xml version="1.0"?>
<package format="3">
  <name>image_listener</name>
  <version>0.1.0</version>
  <description>ROS 2 WebRTC video, input, and robot-state gateway.</description>

  <maintainer email="mateuszwatly@gmail.com">Mateusz Wątły</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/ichores-research/vive_teleop</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
