@startuml
!pragma layout smetana
title component - moveit_server communication

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Monospace
skinparam linetype ortho

package "Input topics" {
  queue "/vive/head_pose" as HeadPose
  queue "/vive/hand_target_pose" as HandTarget
  queue "/vive/hand_target_active" as HandActive
  queue "/vive/gripper_opening" as GripperOpening
  queue "/vive/base_command" as BaseInput
  queue "/vive/base_active" as BaseActive
}

package "moveit_server container" {
  component "ViveMoveItServer\nC++ rclcpp" as Teleop
  component "100 Hz Cartesian loop\nfilter + feedback/feed-forward\nspeed/acceleration limits" as ArmLoop
  component "MoveIt Servo component\nintra-process enabled\n7-DOF differential IK" as Servo
  component "move_group" as MoveGroup
  component "robot_state_publisher" as Rsp
}

package "Robot state" {
  queue "/joint_states" as JointStates
  component "TF" as Tf
}

package "Command and observability topics" {
  queue "/head_controller/joint_trajectory" as HeadCommand
  queue "/gripper_controller/joint_trajectory" as GripperCommand
  queue "/key_vel" as BaseCommand
  queue "/servo_node/pose_target_cmds\n(mapped target)" as PoseTarget
  queue "/servo_node/pose_target_active\n(effective gate)" as PoseActive
  queue "/servo_node/delta_twist_cmds" as DeltaTwist
  queue "/arm_controller/joint_trajectory" as ArmCommand
}

HeadPose --> Teleop
HandTarget --> Teleop
HandActive --> Teleop
GripperOpening --> Teleop
BaseInput --> Teleop
BaseActive --> Teleop

JointStates --> Teleop : gripper state
Tf --> ArmLoop : fresh tool pose
Teleop *-- ArmLoop : same process\nlatest-value state
Teleop --> HeadCommand
Teleop --> GripperCommand
Teleop --> BaseCommand
ArmLoop --> PoseTarget : diagnostics / recording
ArmLoop --> PoseActive : effective gate
ArmLoop --> DeltaTwist : physical speed_units

Rsp --> MoveGroup : robot_description + TF
MoveGroup --> Servo : planning scene/model
JointStates --> Servo : seven arm joints
DeltaTwist --> Servo
Servo --> ArmCommand

note bottom of ArmLoop
  Deadman clutch maps the configured controller-top local frame
  to arm_tool_link. Translation remains base_footprint aligned.
end note

@enduml
