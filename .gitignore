.env
# =========================
# Unity (core folders)
# =========================

unity-vr-headset/[Ll]ibrary/
unity-vr-headset/[Tt]emp/
unity-vr-headset/[Oo]bj/
unity-vr-headset/[Bb]uild/
unity-vr-headset/[Bb]uilds/
unity-vr-headset/[Ll]ogs/
unity-vr-headset/[Uu]ser[Ss]ettings/

# =========================
# Unity generated files
# =========================

unity-vr-headset/*.csproj
unity-vr-headset/*.sln
unity-vr-headset/*.unityproj
unity-vr-headset/*.user
unity-vr-headset/*.userprefs
unity-vr-headset/*.pidb
unity-vr-headset/*.booproj
unity-vr-headset/*.svd
unity-vr-headset/*.pdb
unity-vr-headset/*.opendb

# =========================
# OS junk
# =========================

.DS_Store
Thumbs.db
desktop.ini

# =========================
# IDEs
# =========================

.vs/
.vscode/
.idea/

# =========================
# Builds
# =========================

*.apk
*.aab
*.exe
*.app
*.unitypackage

# Local environment and tool state. Do not ignore every dotfile: repository
# configuration such as .github workflows and .dockerignore must be trackable.
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/
.agents/

# =========================
# Crash / logs
# =========================

logs/
*.log
sysinfo.txt

# =========================
# Addressables (if used later)
# =========================

unity-vr-headset/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

__pycache__/
*.py[cod]

# Local controller telemetry
recordings/*.jsonl

# Local crash and editor recovery artifacts
unity-vr-headset/mono_crash.*
unity-vr-headset/UpgradeLog.htm
unity-vr-headset/Assets/AutosavedBeforeTeleop.unity
unity-vr-headset/Assets/AutosavedBeforeTeleop.unity.meta
