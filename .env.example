# Copy to .env and adapt values for the local lab network. Never commit .env.
ROS_DOMAIN_ID=67

# Static field/Ethernet deployment.
NIC=enp2s0f0
ROBOT_IP=10.68.0.1

# Wi-Fi overlay. Leave WEBRTC_HOST_IP unset to use route/interface detection.
WEBRTC_NIC=wlan0
ROS_FIELD_HOST_IP=10.68.0.130
ROS2_DDS_INTERFACE=10.68.0.130
ROS2_DDS_ALLOW_MULTICAST=true

# Replace these before allowing any untrusted client onto the network.
TURN_USER=replace-me
TURN_PASSWORD=replace-with-a-long-random-secret

# Optional space-separated ROS launch arguments.
MOVEIT_SERVER_LAUNCH_ARGS=
# Dataset recording is opt-in. The rosbag recorder stores robot observations,
# robot/controller commands, and the wrist deadman only; it rejects other
# /vive user-input topics.
VIVE_TELEOP_RECORD_DATASET=0
VIVE_TELEOP_RECORDING_ROOT=./recordings
VIVE_TELEOP_RECORDING_MODE=deadman_window
VIVE_TELEOP_RECORDING_POST_ROLL_SEC=0.75
VIVE_TELEOP_RECORDING_GATE_TIMEOUT_SEC=0.25
VIVE_TELEOP_RECORDING_MIN_FREE_BYTES=20000000000
# Numeric owner for dataset files; the Wi-Fi launcher defaults these to the
# invoking host user.
VIVE_TELEOP_RECORDING_UID=1000
VIVE_TELEOP_RECORDING_GID=1000
