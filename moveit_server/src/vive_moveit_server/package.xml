<?xml version="1.0"?>
<package format="3">
  <name>vive_moveit_server</name>
  <version>0.1.0</version>
  <description>ROS 2 MoveIt teleoperation server for Vive WebRTC input.</description>

  <maintainer email="mateuszwatly@gmail.com">Mateusz Wątły</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/ichores-research/vive_teleop</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_servo</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tiago_description</exec_depend>
  <exec_depend>tiago_moveit_config</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
