@startuml
!pragma layout smetana
title vive_teleop architecture

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Monospace

actor "Browser debug client\nindex.html\nhttp://localhost:8000" as Browser
actor "Unity VR headset\nunity-vr-headset" as Unity

node "Robot network\n10.68.0.0/24" as Net {
  node "Robot\nROS2 graph\n10.68.0.1" as Robot {
    component "ROS2 camera topic\n/head_front_camera/rgb/image_raw" as RobotCamera
    component "ROS2 joint states\n/joint_states" as RobotJointStates
    component "ROS2 arm controller\n/arm_controller/joint_trajectory" as RobotArmCommand
    component "ROS2 head controller\n/head_controller/joint_trajectory" as RobotHeadCommand
    component "ROS2 gripper controller\n/gripper_controller/joint_trajectory" as RobotGripperCommand
  }

  node "ros2_app container\n10.68.0.132\nport 8088" as Ros2App {
    component "image_subscriber\nROS2 node" as ImageSubscriber
    component "LatestFrameVideoTrack" as VideoTrack
    component "WebRTCServer\naiohttp + aiortc" as WebRTCServer
    component "InputPublisher\nROS2 node" as InputPublisher
    component "RobotInputState\nROS2 node" as RobotInputState
    queue "ROS2 topic\n/vive/head_pose" as HeadPoseTopic
    queue "ROS2 topic\n/vive/hand_target_pose" as HandTargetTopic
    queue "ROS2 topic\n/vive/hand_target_active" as HandTargetActiveTopic
    queue "ROS2 topic\n/vive/gripper_opening" as GripperOpeningTopic
  }

  node "moveit_server container\n10.68.0.134" as MoveItContainer {
    component "robot_state_publisher\nTIAGo description" as RobotStatePublisher
    component "move_group\nTIAGo MoveIt config" as MoveGroup
    component "vive_moveit_server\nhead, clutch, wrist target,\ngripper control" as MoveItServer
    component "servo_pose_bridge\npose error + feed-forward" as ServoPoseBridge
    component "moveit_servo\n7-joint arm group" as ServoNode
    queue "ROS2 topic\n/joint_states" as JointStateTopic
    queue "ROS2 topic\n/servo_node/pose_target_cmds" as ServoPoseTopic
    queue "ROS2 topic\n/servo_node/pose_target_active" as ServoPoseActiveTopic
    queue "ROS2 topic\n/servo_node/delta_twist_cmds" as ServoTwistTopic
    queue "ROS2 topic\n/head_controller/joint_trajectory" as HeadCommandTopic
    queue "ROS2 topic\n/arm_controller/joint_trajectory" as ArmCommandTopic
    queue "ROS2 topic\n/gripper_controller/joint_trajectory" as GripperCommandTopic
  }

  node "coturn container\n10.68.0.133:3478" as Coturn {
    component "TURN relay\nuser dummy/dummy" as TurnRelay
  }
}

cloud "Docker host" as Host {
  component "python3 -m http.server 8000" as StaticServer
}

RobotCamera --> ImageSubscriber : ROS2 sensor_msgs/Image
RobotJointStates --> JointStateTopic : ROS2 sensor_msgs/JointState
ArmCommandTopic --> RobotArmCommand : ROS2 trajectory_msgs/JointTrajectory
HeadCommandTopic --> RobotHeadCommand : ROS2 trajectory_msgs/JointTrajectory
GripperCommandTopic --> RobotGripperCommand : ROS2 trajectory_msgs/JointTrajectory

ImageSubscriber --> VideoTrack : latest BGR frame
VideoTrack --> WebRTCServer : media track
WebRTCServer --> InputPublisher : data-channel JSON messages
WebRTCServer --> RobotInputState : GET /robot_state
InputPublisher --> HeadPoseTopic : geometry_msgs/PoseStamped
InputPublisher --> HandTargetTopic : geometry_msgs/PoseStamped
InputPublisher --> HandTargetActiveTopic : std_msgs/Bool
InputPublisher --> GripperOpeningTopic : std_msgs/Float64\nnormalized 0..1
HeadPoseTopic --> MoveItServer : raw HMD PoseStamped
HandTargetTopic --> MoveItServer : wrist pose target
HandTargetActiveTopic --> MoveItServer : wrist deadman state
GripperOpeningTopic --> MoveItServer : normalized finger opening
JointStateTopic --> MoveItServer : measured head + gripper state
JointStateTopic --> ServoNode : measured 7-joint arm state
RobotJointStates --> RobotInputState : head + finger positions
RobotStatePublisher --> MoveGroup : robot_description + TF
RobotStatePublisher --> RobotInputState : wrist + head TF
RobotStatePublisher --> ServoNode : robot_description + TF
MoveItServer --> ServoPoseTopic : absolute 6-DoF wrist target
MoveItServer --> ServoPoseActiveTopic : deadman gate + queue clear
ServoPoseTopic --> ServoPoseBridge : target pose
ServoPoseActiveTopic --> ServoPoseBridge : disable pursuit + zero halt
ServoPoseBridge --> ServoTwistTopic : physical Cartesian velocity
ServoTwistTopic --> ServoNode : speed_units TwistStamped
ServoNode --> ArmCommandTopic : 7-joint trajectory\njoint-limit + singularity scaling
MoveItServer --> HeadCommandTopic : head_1_joint + head_2_joint\n20 Hz, deadband, 90% limits
MoveItServer --> GripperCommandTopic : synchronized finger targets\n0..0.045 m, velocity-limited

StaticServer --> Browser : serves index.html
Browser --> WebRTCServer : HTTP POST /offer\nSDP offer/answer
Browser --> WebRTCServer : HTTP POST /input_offer\nSDP offer/answer
Browser --> WebRTCServer : input data channel\n20 Hz unity_teleop_pose
Browser --> WebRTCServer : GET /robot_state\nsafe initial head, wrist, gripper state
Browser .. TurnRelay : ICE relay candidates

Unity --> WebRTCServer : WebRTC video + 6-DoF wrist input\nvertical trackpad/joystick gripper target
Unity .. TurnRelay : ICE relay candidates

note right of WebRTCServer
  Runtime entrypoint:
  ros2 run image_listener image_subscriber

  image_subscriber delegates to teleop_webrtc,
  which wires WebRTCServer to the ROS nodes.
end note

note right of MoveItServer
  Default teleop path:
  - HMD yaw/pitch -> head pan/tilt
  - publishes /head_controller/joint_trajectory
  - Servo arm group uses arm_1_joint through arm_7_joint
  - torso_lift_joint excluded
  - uncapped pose bridge -> Cartesian speed commands
  - Servo enforces joint limits and singularity scaling
  - collision checking disabled for maximum speed
  - publishes 7-joint /arm_controller/joint_trajectory
  - normalized gripper opening -> two finger joints
  - publishes /gripper_controller/joint_trajectory
end note

note bottom of Net
  Runtime network: docker compose field_net
  driver: ipvlan, mode: l2
  Direct CycloneDDS peer: 10.68.0.1
end note

@enduml
